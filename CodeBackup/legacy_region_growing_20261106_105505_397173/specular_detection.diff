+def _grow_specular_region(bgr, seeds, eligible, radius, color_max):
+    """8-connected growth, at most radius steps from immutable original seeds.
+
+    Color is max-channel-normalized BGR (0..255), L-infinity distance to
+    the nearest ORIGINAL seed. This permits dimmer edges without gradual
+    color drift. A pixel failing its nearest seed's color check is excluded
+    even if another, farther seed would accept it (conservative policy).
+    """
+    grown=seeds.copy()
+    if radius==0 or not np.any(seeds) or np.all(seeds):return grown
+    distance,labels=cv2.distanceTransformWithLabels(
+        (~seeds).astype(np.uint8),cv2.DIST_C,3,labelType=cv2.DIST_LABEL_PIXEL)
+    color=bgr.astype(np.float32)
+    color*=255.0/np.maximum(color.max(axis=2,keepdims=True),1.0)
+    seed_colors=np.zeros((int(labels.max())+1,3),np.float32)
+    seed_colors[labels[seeds]]=color[seeds]
+    color_ok=np.max(np.abs(color-seed_colors[labels]),axis=2)<=color_max
+    allowed=eligible & color_ok & (distance<=radius)
+    kernel=np.ones((3,3),np.uint8)
+    for _ in range(radius):
+        expanded=(cv2.dilate(grown.astype(np.uint8),kernel)>0)&allowed
+        updated=grown|expanded
+        if np.array_equal(updated,grown):break
+        grown=updated
+    return grown
 
 
